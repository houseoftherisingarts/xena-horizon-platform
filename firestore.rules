rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // UID whitelist must match lib/admins.ts
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['O5qf5A3WdfV7daxkBKOIt0RnBUD2']
            || (request.auth.token.email_verified == true
                && request.auth.token.email in ['houseoftherisingarts@gmail.com', 'laurie.belhumeur@gmail.com']));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Borne tolérante à l'absence : le champ, s'il est présent, doit être une string sous la taille max.
    function texteBorne(data, champ, max) {
      return !(champ in data) || (data[champ] is string && data[champ].size() < max);
    }

    // Bornes du sous-objet `projet` du dossier client, tolérantes à son absence.
    function projetValide(data) {
      return !('projet' in data)
             || (data.projet is map
                 && texteBorne(data.projet, 'titre', 200)
                 && texteBorne(data.projet, 'description', 5000)
                 && texteBorne(data.projet, 'objectif', 2000)
                 && texteBorne(data.projet, 'echeance', 20));
    }

    // Bornes de taille des champs texte du dossier client, tolérantes à leur absence.
    // `revue` n'y figure jamais : c'est le jugement de Laurie, jamais un champ que le client peut fixer.
    function dossierBornesOK(data) {
      return texteBorne(data, 'telephone', 40)
             && texteBorne(data, 'ville', 80)
             && texteBorne(data, 'discipline', 80)
             && texteBorne(data, 'photoURL', 500)
             && texteBorne(data, 'banniereURL', 500)
             && texteBorne(data, 'bio', 1000)
             && liensValide(data)
             && (!('pieces' in data) || (data.pieces is map && data.pieces.keys().size() <= 20))
             && (!('profil' in data) || data.profil in ['artiste', 'entrepreneur', 'organisme'])
             && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
             && projetValide(data);
    }

    // Les liens du profil : clés connues d'avance, valeurs bornées.
    function liensValide(data) {
      return !('liens' in data)
             || (data.liens is map
                 && data.liens.keys().hasOnly(['site', 'instagram', 'facebook', 'autre'])
                 && texteBorne(data.liens, 'site', 300)
                 && texteBorne(data.liens, 'instagram', 300)
                 && texteBorne(data.liens, 'facebook', 300)
                 && texteBorne(data.liens, 'autre', 300));
    }

    function courrielValide(v) {
      return v is string && v.size() < 200 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // Public-write submission endpoints (anti-spam: enforce shape only)
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if courrielValide(request.resource.data.email)
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 200
                    // Un rendez-vous pris par une personne déjà connectée porte son uid, jamais celui d'un autre.
                    && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
                    && request.resource.data.keys().hasOnly(['name','email','message','source','read','archived','createdAt','uid']);
      allow update, delete: if isAdmin();
    }

    match /subscribers/{subId} {
      allow read: if isAdmin();
      allow create: if courrielValide(request.resource.data.email)
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 120))
                    && request.resource.data.keys().hasOnly(['email','name','tags','status','source','lang','createdAt']);
      allow update, delete: if isAdmin();
    }

    // Public-readable site content
    match /homeBlocks/{blockId} { allow read: if true; allow write: if isAdmin(); }
    match /landingPages/{slug} { allow read: if true; allow write: if isAdmin(); }
    match /landingPages/{slug}/blocks/{blockId} { allow read: if true; allow write: if isAdmin(); }
    match /products/{productId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }
    // settings/facturation porte l'identité légale de Laurie (NEQ, TPS, TVQ) : admin seulement.
    // Ce que la personne facturée doit voir vit dans le miroir factures_publiques, jamais ici.
    match /settings/{key} { allow read: if key != 'facturation' || isAdmin(); allow write: if isAdmin(); }

    // Miroir public d'une facture publiée : lisible par jeton (assez long pour être imprévisible),
    // jamais listable, jamais écrit ailleurs que par Laurie (lib/factures.ts, publierFacture).
    // La collection documents (source, avec l'identité de la personne facturée) reste admin seulement.
    match /factures_publiques/{jeton} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Les paiements Stripe reçus pour une offre (functions/src/produits/stripe.ts, webhookStripeProduits) :
    // seule la fonction (Admin SDK, ignore ces règles) y écrit; Laurie les consulte, personne d'autre.
    match /commandes/{commandeId} { allow read: if isAdmin(); allow write: if false; }

    // Admin-only collections
    match /clients/{clientId}     { allow read, write: if isAdmin(); }
    match /documents/{docId}       { allow read, write: if isAdmin(); }
    match /gallery/{imageId}       { allow read, write: if isAdmin(); }
    match /newsletters/{nlId}      { allow read, write: if isAdmin(); }
    match /newsletters/{nlId}/{document=**} { allow read, write: if isAdmin(); }

    // Catalogue des pièces et des étapes du dossier (settings/dossier) : couvert par /settings ci-dessus.

    // Dossier client : un document par personne accompagnée, identifié par son uid.
    match /dossiers/{uid} {
      // La personne lit son propre dossier; seule Laurie peut lister la collection.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // `revue` est absente de la liste hasOnly : un dossier créé par le client ne peut jamais en porter une.
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.courriel is string
                    && request.resource.data.courriel.size() < 200
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() < 120
                    && request.resource.data.etape == 'contact'
                    && request.resource.data.archive == false
                    && request.resource.data.pieces is map
                    && dossierBornesOK(request.resource.data)
                    && request.resource.data.keys().hasOnly(['uid','courriel','nom','telephone','ville','photoURL','banniereURL','bio','liens','profil','discipline','projet','etape','pieces','createdAt','updatedAt','derniereActiviteClient','nonLusAdmin','nonLusClient','archive','tags']);
      // La personne modifie son profil, son projet et ses pièces; l'étape, l'archivage et la revue (jugement de Laurie) restent hors de sa portée.
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['nom','telephone','ville','photoURL','banniereURL','bio','liens','profil','discipline','projet','pieces','updatedAt','derniereActiviteClient','nonLusAdmin','nonLusClient'])
                        && request.resource.data.pieces is map
                        && request.resource.data.nom is string
                        && request.resource.data.nom.size() < 120
                        && dossierBornesOK(request.resource.data));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.texte is string
                      && request.resource.data.texte.size() > 0
                      && request.resource.data.texte.size() < 5000
                      && request.resource.data.deUid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.keys().hasOnly(['texte','de','deUid','luParAdmin','luParClient','createdAt'])
                      && (
                        (isAdmin() && request.resource.data.de == 'admin')
                        || (isOwner(uid) && request.resource.data.de == 'client')
                      );
        // Chacun ne marque que ses propres lectures.
        allow update: if isAdmin()
                      || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luParClient']));
        allow delete: if isAdmin();
      }

      // Notes privées de Laurie : jamais lisibles par la personne accompagnée.
      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }


    // Rendez-vous : la personne connectée demande un créneau dans son propre nom, Laurie confirme, annule ou complète.
    function rdvValide(data) {
      return data.nom is string && data.nom.size() < 120
             && data.courriel is string && data.courriel.size() < 200
             && data.debut is timestamp && data.fin is timestamp
             && data.fin > data.debut
             && data.duree is number && data.duree >= 15 && data.duree <= 240
             && data.fin.toMillis() - data.debut.toMillis() == data.duree * 60000
             && data.salle is string && data.salle.size() < 80
             && (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }
    match /rendezvous/{rdvId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
                    || (isOwner(request.resource.data.uid)
                        && request.resource.data.statut == 'demande'
                        && request.resource.data.creePar == 'client'
                        && request.resource.data.debut > request.time
                        && rdvValide(request.resource.data)
                        && request.resource.data.keys().hasOnly(['uid','nom','courriel','debut','fin','duree','statut','salle','note','creePar','createdAt','updatedAt']));
      // La personne ne peut qu'annuler le sien; le reste appartient à Laurie.
      allow update: if isAdmin()
                    || (isOwner(resource.data.uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','updatedAt'])
                        && request.resource.data.statut == 'annule');
      allow delete: if isAdmin();
    }
    // Miroir sans donnée personnelle : les personnes connectées voient les créneaux déjà pris.
    match /occupations/{rdvId} {
      allow read: if request.auth != null;
      // Le miroir n'existe que pour un rendez-vous réel écrit dans le même lot (getAfter voit l'état après le lot),
      // au nom de la personne, aux mêmes heures : impossible de bloquer l'agenda avec une occupation fantôme.
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.debut is timestamp
                        && request.resource.data.fin is timestamp
                        && request.resource.data.fin > request.resource.data.debut
                        && request.resource.data.keys().hasOnly(['debut','fin'])
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.uid == request.auth.uid
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.debut == request.resource.data.debut
                        && getAfter(/databases/$(database)/documents/rendezvous/$(rdvId)).data.fin == request.resource.data.fin);
      allow delete: if isAdmin()
                    || (request.auth != null && get(/databases/$(database)/documents/rendezvous/$(rdvId)).data.uid == request.auth.uid);
      allow update: if isAdmin();
    }
    // occupations/{id} peut aussi porter source == 'google' (plage tirée de son agenda Google, écrite par
    // agendaGoogleSync) et rendezvous/{id} un champ googleEventId : les deux sont posés par les Cloud
    // Functions via l'Admin SDK, qui ignore ces règles. Rien n'y touche depuis le client, admin compris.

    // Le jeton Google de Laurie (functions/src/agenda/google.ts) : aucune règle client, admin exclu aussi.
    // Seules les Cloud Functions (Admin SDK) lisent et écrivent ce document.
    match /prive/{docId} { allow read, write: if false; }

    // Le coffre pour Vexel : les informations que Laurie dépose pour Alex, chiffrées dans le navigateur avec la clé
    // publique de Vexel (lib/coffre.ts). Firestore ne voit qu'un texte chiffré et un résumé (nom, quatre derniers chiffres).
    match /coffre/{docId} { allow read, write: if isAdmin(); }

    // Témoignages audio (accueil) : publics quand publiés, gérés par Laurie.
    match /temoignagesAudio/{temId} {
      allow read: if resource.data.publie == true || isAdmin();
      allow write: if isAdmin();
    }

    // Capsules vidéo (accueil, mode éducatif) : publiques quand publiées, gérées par Laurie.
    match /videos/{videoId} {
      allow read: if resource.data.publie == true || isAdmin();
      allow write: if isAdmin();
    }

    // Ressources partagées avec les personnes accompagnées (guides, gabarits).
    match /ressources/{resId} {
      allow read: if request.auth != null && (resource.data.visibleClients == true || isAdmin());
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
