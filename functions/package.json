{
  "name": "functions",
  "description": "Firebase Cloud Functions for Xena Horizon — envoi de l'infolettre.",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "verif:agenda-google": "tsx verif-agenda-google.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.0",
    "googleapis": "^178.1.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "private": true
}
